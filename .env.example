# Copy to .env and fill in your Confluent Cloud values

# Confluent Cloud Kafka — from Confluent Cloud console → Cluster → API Keys
CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxxx.us-east-1.aws.confluent.cloud:9092
CONFLUENT_API_KEY=your-kafka-api-key
CONFLUENT_API_SECRET=your-kafka-api-secret

# Schema Registry — from Confluent Cloud console → Schema Registry → API Keys
# SR_URL example: https://psrc-xxxxxx.us-east-2.aws.confluent.cloud
CONFLUENT_SR_URL=https://psrc-xxxxxx.us-east-2.aws.confluent.cloud
CONFLUENT_SR_API_KEY=your-sr-api-key
CONFLUENT_SR_API_SECRET=your-sr-api-secret
# SR Cluster ID — from Confluent Cloud console → Schema Registry → Cluster settings
# Format: lsrc-xxxxxx
CONFLUENT_SR_CLUSTER_ID=lsrc-xxxxxx

# Topics (defaults shown — override if needed)
SOURCE_TOPIC=raw-messages
SINK_TOPIC_CLASSIFIED=classified-messages
SINK_TOPIC_SAFE=classified-safe
SINK_TOPIC_AUDIT=classification-audit
CONSUMER_GROUP=auto-data-classifier
