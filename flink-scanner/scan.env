# ── Scan schedule ─────────────────────────────────────────────────────────────
# How often Flink fires and emits a new batch of classifications.
SCAN_INTERVAL_MINUTES=60

# How many minutes of recent topic data to inspect per scan.
# The Flink TUMBLE window fires every SCAN_INTERVAL_MINUTES but only classifies
# the last SAMPLE_WINDOW_MINUTES of messages — keeping cost low.
SAMPLE_WINDOW_MINUTES=2

# ── Confluent Cloud — Flink ────────────────────────────────────────────────────
CONFLUENT_ENVIRONMENT=env-xxxxx
CONFLUENT_COMPUTE_POOL=lfcp-xxxxx
CONFLUENT_CLOUD_REGION=us-east-1
CONFLUENT_CLOUD_PROVIDER=aws

# ── Confluent Cloud — Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_KEY=YOUR_KAFKA_API_KEY
KAFKA_SECRET=YOUR_KAFKA_API_SECRET

# ── Topic to scan ──────────────────────────────────────────────────────────────
# The scan job reads from SOURCE_TOPIC and writes results to
# {SOURCE_TOPIC}-scan-results (created automatically on first start).
SOURCE_TOPIC=payments

# ── Classifier service ─────────────────────────────────────────────────────────
# Needs a public HTTPS endpoint (not localhost).
# Local dev: run  ngrok http 8000  and paste the ngrok URL here.
CLASSIFIER_URL=https://your-classifier.example.com
CLASSIFIER_MAX_LAYER=3        # 1=field name only | 2=+regex | 3=+AI

# ── Schema Registry ────────────────────────────────────────────────────────────
SR_URL=https://psrc-xxxxx.us-east-1.aws.confluent.cloud
SR_KEY=YOUR_SR_API_KEY
SR_SECRET=YOUR_SR_API_SECRET
